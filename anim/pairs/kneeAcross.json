{
  "id": "kneeAcross",
  "note": "Side control to the mount: the knee slides across the belly. top: the man on top. From across him, chest down, he lifts his hips with the crossface kept, brings the near knee up onto the belly and slides it across to the far side, turning to face up the body as he goes, then sits down astride. The man underneath turns in to him, then is flattened.",
  "from": ["side"],
  "to": ["mount"],
  "keys": [
    { "t": 0, "top": "@from", "bot": "@from", "tan": "flat" },
    { "t": 300, "note": "hips up, the near knee onto the belly; he turns in to him",
      "top": { "set": { "root": [0, 0.46], "pelvis": [0, 0.85, 0], "spine": [0, 0.2, 0],
        "footR": [-0.1, 0.1, 0.2], "toeR": [3.14, 0.5], "kneeR": [1, -0.2, 0.3] } },
      "bot": { "set": { "pelvis": [-0.3, -1.4, 0], "spine": [0, -0.1, -0.1], "footL": [0.35, 0.07, -0.1], "footR": [0.32, 0.07, 0.2], "kneeL": [0.2, 1, -0.2], "kneeR": [0.2, 1, 0.5] } } },
    { "t": 650, "note": "the knee slides across to the far side, turning up the body; he's flattened",
      "top": { "set": { "root": [0.05, 0.5], "pelvis": [0, 0.5, 0], "spine": [0, 0.15, 0], "neck": [0, 0],
        "footR": [0.25, 0.3, 0.3], "toeR": [2.6, 0.6], "kneeR": [1, -0.6, 0.3] } },
      "bot": { "mix": 0.35 } },
    { "t": 950, "note": "astride, the hips over his belly",
      "top": { "mix": 0.7, "add": { "root": [0, 0.06] } },
      "bot": { "mix": 0.8 } },
    { "t": 1200, "note": "sits down onto him", "top": { "mix": 1, "add": { "root": [0, -0.04] } }, "bot": { "mix": 1 } },
    { "t": 1500, "top": "@to", "bot": "@to", "tan": "flat" }
  ],
  "grips": [
    { "who": "top", "eff": "handL", "to": ["N", "Hd", 0.4], "out": [-1, 0, 0], "t": [-1, 700] },
    { "who": "top", "eff": "handR", "to": ["W", "Ch", 0.4], "out": [1, 0, 0], "t": [200, 1000] },
    { "who": "bot", "eff": "handL", "to": ["P", "W", 0.3], "out": [1, 0, 0], "t": [150, 700] },
    { "who": "bot", "eff": "handR", "to": ["knR", "hpR", 0.2], "t": [300, 800] }
  ],
  "place": {
    "top": [[0, 0, 0, 0, 0], [300, 0.05, 0, 0, 0], [650, 0.4, 0, 0, 0], [950, 0.82, 0, 0, 0], [1200, 0.98, 0, 0, 0], [1500, 1, 0, 0, 0]],
    "bot": [[0, 0, 0, 0, 0], [1500, 1, 0, 0, 0]]
  },
  "land": { "top": { "at": 0.8, "root": -0.0012, "spine": 0.002 }, "bot": { "at": 0.8, "root": -0.0006 } },
  "deny": { "at": 430, "hold": 300, "back": 700,
    "note": "stopped as the knee comes onto the belly: he turns in further, a hand on the knee and one on the hip, and pushes it back off",
    "top": { "add": { "root": [-0.03, 0.02] } },
    "bot": { "add": { "pelvis": [-0.2, 0, 0] } },
    "grips": [
      { "who": "bot", "eff": "handR", "to": ["knR", "hpR", 0.2], "t": [-150, 450] },
      { "who": "bot", "eff": "handL", "to": ["P", "W", 0.3], "out": [1, 0, 0], "t": [-150, 450] }
    ] },
  "revAt": 360, "revNote": "caught with his hips up and one knee off the mat, his base gone: the bridge rolls him over the top"
}
